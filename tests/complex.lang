fn factorial(n: Int): Int =
    (if n == 1 { 1 } else { n * factorial(n - 1) })
    
fn loopy(): Int = {
    let counter: Int = 10;
    let sum: Int = 0;
    while counter > 0 {
        sum = sum + 2;
        counter = counter - 1;
    };
    
    sum
}

