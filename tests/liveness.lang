fn liveVarStress(): Int = {
    let a: Int = 1;
    let b: Int = a + 2;
    let c: Int = b * 3;
    let d: Int = c - a;
    let e: Int = d + b;
    let f: Int = e * 2;
    let g: Int = f / 3;
    let h: Int = g + (a + b) + c;
    let i: Int = h - d;
    let j: Int = i + e;
    let k: Int = j * 2 - f;
    let m: Int = k + g + h;
    let n: Int = m / (2 + a);
    let o: Int = n + m + k;
    let p: Int = o - n + j;
    let q: Int = p * 2 + i;
    let r: Int = q - o + h;
    let s: Int = r + p - g;
    let t: Int = s + q - f;
    let u: Int = t + r - e;
    let v: Int = u + s - d;
    let w: Int = v + t - c;
    let x: Int = w + u - b;
    let y: Int = x + v - a;
    let z: Int = y + w + x;

    let acc: Int = z;
    let idx: Int = 0;

    while idx < 5 {
        let inner: Int = acc + idx;
        acc = acc + inner - (idx * 2) + (idx + a);
        if (idx - 2) == 0 {
            let shadow: Int = acc + y;
            acc = shadow - inner + (idx + b);
        } else {
            let shadow: Int = acc - x;
            acc = shadow + inner - (idx + c);
        };
        idx = idx + 1;
    };

    let branchA: Int = if acc > 0 {
        let tmp: Int = acc + d + e;
        tmp - f + g
    } else {
        let tmp: Int = acc - h - i;
        tmp + j - k
    };

    let branchB: Int = if branchA < acc {
        let tmp: Int = branchA + v;
        tmp + acc
    } else {
        let tmp: Int = branchA - acc;
        tmp - acc
    };

    let l: Int = branchA / 2 + m;
    let branchC: Int = branchB + l + n;
    let finalAcc: Int = acc + branchA + branchB + branchC + o + p + q + r + s + t + u + v + w + x + y + z;
    finalAcc - (l / 2)
}

fn main(): Int = liveVarStress()
