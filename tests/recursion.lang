fn main(): Int = {
    if is_even(47) {
        fibonacci(12) // 144
    } else {
        fibonacci(14) // 377
    }
}

fn fibonacci(n: Int): Int =
    if n == 0 {
        0
    } else {
        if n == 1 {
            1
        } else {
            fibonacci(n-1) + fibonacci(n-2)
        }
    }

fn is_even(n: Int): Bool = {
    if (n == 0) {
        true
    } else {
        is_odd(n - 1)
    }
}

fn is_odd(n: Int): Bool = {
    if (n == 0) {
        false
    } else {
        is_even(n - 1)
    }
}